# Telegram API credentials (obtenir sur https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION=bv_copier_session

# Channels
SOURCE_CHANNEL=@source_channel
TARGET_CHANNEL=@target_channel
ORDER_ADMIN=your_admin_username

# Translation
SOURCE_LANG=ru
TARGET_LANG=ar

# Settings
TEST_MODE=false
PUBLISH_DELAY=1.5
MAX_RETRIES=3
ALBUM_COLLECT_TIMEOUT=3
DB_PATH=data/copier.db
WEB_HOST=0.0.0.0
WEB_PORT=8000
